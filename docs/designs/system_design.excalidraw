   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2460 The big cache \u2014 FLAGSHIP\nDiscord Read States conditions\nhand-written sharded LRU, 5 variants\nsweep 1M/5M/10M entries\np99/p99.9 \u00b7 mem-mgmt CPU \u00b7 memory",
   "originalText": "\u2460 The big cache \u2014 FLAGSHIP\nDiscord Read States conditions\nhand-written sharded LRU, 5 variants\nsweep 1M/5M/10M entries\np99/p99.9 \u00b7 mem-mgmt CPU \u00b7 memory",
